# Copy to .env and fill in real values.

# Set to True in production (HTTPS).
PRODUCTION=False

# Comma-separated host names.
ALLOWED_HOST=127.0.0.1,localhost

# Public origin used for canonical URLs, Open Graph, sitemap, and RSS.
FULL_DOMAIN=http://localhost:8000

# Comma-separated origins for CSRF when the site is behind a proxy.
CSRF_TRUSTED_ORIGINS=

# Required by POST /custom-admin/api/analytics/flush/.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYTICS_FLUSH_TOKEN=
