<?xml version="1.0" encoding="UTF-8"?>

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
    {% for i in items %}
        <url>
            <loc>{{ i.url}}</loc>
            <lastmod>{{ i.updated_at|date:"Y-m-d" }}</lastmod>

            {% if i.image %}
            <image:image>
                <image:loc>{{ i.image.url }}</image:loc>
            </image:image>

            {% endif %}
        </url>
    {% endfor %}
</urlset>

{% comment %} 
DONT FORGET THAT A XML MUST HAVE A MAXIMUM SITEMAP OF 50,000 URLS!!
{% endcomment %}
